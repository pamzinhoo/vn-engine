# ============================================================================
# ROTA DO KUROYA — DIA 0
# Estrutura: hub de check-ins (armarios / dormitorio / aulas) -> escolha de
# refeicao (uma so) -> fim do dia. O dormitorio fica travado ate os armarios
# serem feitos, porque e la que a Elizabeth se oferece para levar a mala.
# ============================================================================

label hub_checkins:
    menu:
        "Verificar armários" if not k_armarios:
            jump kuroya_armarios
        "Verificar dormitório {color=#888888}(trancado){/color}" if not k_armarios:
            p "{cps=30}{color=#FFFFFF}Preciso resolver os armários antes.{/color}{/cps}"
            p "{cps=30}{color=#FFFFFF}Não vou subir carregando essa mala toda.{/color}{/cps}"
            jump hub_checkins
        "Verificar dormitório" if k_armarios and not k_dormitorio:
            jump kuroya_dormitorio
        "Verificar aulas" if not k_aulas:
            jump kuroya_aulas
        "Explorar o campus" if k_armarios and k_aulas and k_dormitorio:
            jump kuroya_exploracao


