# Directories that Ren'Py changes files in.
/game/saves
/game/cache

# Compiled script files. These are important for saving, and so should
# be preserved by developer and build systems after the game has been released.
/game/**/*.rpyc
/game/**/*.rpymc

# Files Ren'Py can generate.
/game/**/*.bak
/game/**/*.new
/game/**/*.old

# Error, log, and output files.
/errors.txt
/files.txt
/image_cache.txt
/log.txt
/save_dump.txt
/traceback.txt

# Launcher-generated files.
/dialogue.tab
/dialogue.txt
/strings.json

# --- Build e ferramentas locais ---

# Pacotes gerados pelo launcher do Ren'Py (zip/apk/tar de distribuicao).
/*-dists/

# Binario do butler (upload para o itch.io), baixado a parte.
/butler-windows-amd64/

# Projeto temporario criado pelo build do Android.
/p/

# --- Assinatura Android ---
# NUNCA versionar: quem tem a keystore consegue publicar update assinado
# como se fosse voce. Guardar em backup offline, fora do repositorio.
*.keystore

# Configuracao gerada pelo launcher (contem caminhos e senhas locais).
/VnGame/android.json
/VnGame/project.json
